rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Poortjie Main Data ---
    match /poortjie/{document} {
      allow read: if true;
      allow write: if false; 
    }

    // --- Service Categories ---
    match /poortjie/services/{category}/{businessId} {
      allow read: if true;
      
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['ratings', 'rating', 'ratingCount']);
    }

    // --- News & Alerts ---
    match /poortjie/news/updates/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    match /poortjie/news {
      allow read: if true;
    }

    match /poortjie/services {
      allow read: if true;
    }

    // --- User Management ---
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.digilayn.is_super_user == true
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // --- Analytics/Traces ---
    match /user_traces/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // --- Business Applications ---
    match /poortjie/applications/listings/{listingId} {
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;

      allow read, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;
    }
  }
}